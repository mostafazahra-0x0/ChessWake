<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Same style name, dark platform parent. This is the window the user sees for
      the few milliseconds before Compose composes its first frame, so it has to
      match the theme ChessWakeTheme will pick for a system-dark device.
    -->
    <style name="Theme.ChessWake" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
