<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a white pawn.

  minSdk is 26, so every launcher uses the adaptive icon in
  `mipmap-anydpi-v26` and there are no density-specific PNGs to maintain. The
  pawn sits inside the 72dp safe zone of the 108dp canvas so no mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Head -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,38 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0 Z" />

    <!-- Collar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M44,46 L64,46 L64,52 L44,52 Z" />

    <!-- Body, flaring towards the base -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M46,52 L62,52 C62,60 68,66 70,72 L38,72 C40,66 46,60 46,52 Z" />

    <!-- Base -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M34,72 L74,72 L74,79 A3,3 0 0,1 71,82 L37,82 A3,3 0 0,1 34,79 Z" />
</vector>
